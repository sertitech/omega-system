# Copy to .env and fill in the keys you use. `.env` is gitignored.

# Anthropic Messages API — required when provider is "anthropic".
ANTHROPIC_API_KEY=

# OpenAI Responses API — required when provider is "openai".
OPENAI_API_KEY=

# Firecrawl — optional; enables the web_search tool.
FIRECRAWL_API_KEY=
