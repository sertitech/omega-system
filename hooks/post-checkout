#!/bin/sh
# post-checkout — point linked worktrees at the main checkout's build cache.
#
# Wired via `git config core.hooksPath hooks` (see hooks/README.md). Without
# it, every worktree cold-rebuilds the full dependency graph into its own
# target/ — the main build cost in a parallel-worktree workflow. A
# *versioned* .cargo/config.toml cannot carry the fix: an absolute target-dir
# is machine-specific, and a relative one resolves per-worktree. So this hook
# generates an un-versioned, .gitignore'd .cargo/config.toml inside each new
# worktree, pointing build.target-dir at the main checkout's target/.
#
# `git worktree add` runs post-checkout (githooks(5)), so fresh worktrees are
# wired automatically. In the main checkout the hook is a no-op.
#
# Best-effort by design: post-checkout's exit status propagates to the
# `git checkout`/`git switch`/`git worktree add` that fired it, and cache
# wiring is never worth failing a successful checkout over. So no `set -e`:
# every fallible step degrades to a stderr warning and a clean exit. Requires
# git >= 2.31 (--path-format=absolute); older git takes the same warn-and-skip
# path.
#
# No-deps: pure POSIX sh — no pre-commit framework, no Node toolchain.

set -u

warn_skip() {
	echo "post-checkout: warning: $1 — shared build cache not wired." >&2
	exit 0
}

# $3 is 1 for a branch checkout, 0 for a file checkout (git checkout -- <path>).
[ "${3:-0}" = "1" ] || exit 0

git_dir=$(git rev-parse --path-format=absolute --git-dir) || warn_skip "git rev-parse failed (git >= 2.31 required)"
common_dir=$(git rev-parse --path-format=absolute --git-common-dir) || warn_skip "git rev-parse failed (git >= 2.31 required)"
[ -n "$git_dir" ] && [ -n "$common_dir" ] || warn_skip "git rev-parse returned an empty path"

# Main checkout (git-dir == common-dir): its target/ *is* the shared cache.
[ "$git_dir" != "$common_dir" ] || exit 0

marker="generated by hooks/post-checkout"
config=.cargo/config.toml

# Never clobber a config this hook did not write.
if [ -f "$config" ] && ! grep -qF "$marker" "$config"; then
	echo "post-checkout: $config exists and is not hook-generated; leaving it untouched." >&2
	exit 0
fi

# The main worktree is always listed first (git-worktree(1)), with an
# absolute path. In exotic layouts (git clone --separate-git-dir) git cannot
# locate the main worktree at all — the first entry degenerates to the git
# dir itself — so positively identify the project checkout before wiring
# anything, and warn-skip rather than ever pointing cargo at a wrong path.
main_root=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
[ -n "$main_root" ] || warn_skip "could not resolve the main worktree root"
[ -f "$main_root/Cargo.toml" ] || warn_skip "$main_root does not look like the main checkout (git clone --separate-git-dir layout?)"

# Escape \ and " so the path is valid inside a TOML basic string.
shared_target=$(printf '%s/target' "$main_root" | sed 's/\\/\\\\/g; s/"/\\"/g') || warn_skip "path escaping failed"

mkdir -p .cargo || warn_skip "mkdir .cargo failed"
cat >"$config" <<EOF || warn_skip "writing $config failed"
# $marker — machine-local, never committed (.gitignore'd).
# Shares the main checkout's target/ so worktree builds reuse the warm
# dependency cache. Trade-offs (accepted): concurrent builds across worktrees
# serialize on cargo's build-directory lock; \`cargo clean\` from any worktree
# cleans the shared cache; and cargo's freshness check may run a test binary
# built from another tree's sources, so hooks/pre-push uses its own target-push.
[build]
target-dir = "$shared_target"
EOF

echo "post-checkout: builds share $main_root/target"
